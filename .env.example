CLINICALAI_MAX_UPLOAD_MB=25
CLINICALAI_CORS_ORIGINS=http://localhost:8000,http://localhost:5173
CLINICAL_METADATA_MODEL=gemini-3.5-flash-lite
CLINICAL_ROUTER_MODEL=openai/gpt-oss-20b
CLINICAL_SUMMARY_MODEL=gemini-3.5-flash-lite
CLINICAL_ANSWER_MODEL=openai/gpt-oss-120b
