# Existing pipeline configuration
PADDLE_OCR_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Qdrant is read by the existing embedding pipeline (currently defaults to localhost).
# QDRANT_URL=http://localhost:6333

# API configuration. The browser never supplies a patient ID.
